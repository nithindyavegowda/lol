# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local databases
*.db
*.db-journal
prisma/dev.db
prisma/*.db

# user uploads
/public/uploads/

# oversized 3D (GitHub 100MB limit) — keep locally under assets/3d & public/assets/3d
**/spiderman.glb

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local QA / noise
e2e-results.csv
docs/screenshots/*.report.json
docs/screenshots/sprint-8-lighthouse.report.html
