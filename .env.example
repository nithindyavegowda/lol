# Neon Postgres
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Auth — generate a long random secret for production
NEXTAUTH_SECRET="generate-a-long-random-secret"
NEXTAUTH_URL="http://localhost:1234"
AUTH_URL="http://localhost:1234"
# Vercel: set NEXTAUTH_URL, AUTH_URL, and NEXT_PUBLIC_SITE_URL to https://your-app.vercel.app

ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="set-a-strong-password"
ORDER_NOTIFY_EMAIL="you@example.com"

NEXT_PUBLIC_WHATSAPP_NUMBER="918884558657"
NEXT_PUBLIC_SHOP_NAME="LOL"
NEXT_PUBLIC_SHOP_TAGLINE="Made by me, made for you"
NEXT_PUBLIC_SITE_URL="http://localhost:1234"

# Optional — order notify emails
# RESEND_API_KEY=

# Required for admin image uploads on Vercel (local disk uploads only work in development)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
